#!/bin/sh
# wrkq pre-push hook — canonical tracked source for .git/hooks/pre-push.
#
# Installed by `just hooks-install`. It reports the push and how long the hook
# took; it does not verify. `just verify` runs after the push on mini's
# self-hosted runner (T-10161, .github/workflows/post-push-verify.yml), because
# verify in a git hook slows every push for no gain (Lance, 2026-10-03).

# Measurement only: never consumes the ref stdin.
hook_timing=$(python3 tools/hooks/hook-duration.py --start pre-push </dev/null 2>/dev/null) || hook_timing=''
hook_settled() {
  hook_rc=$?
  trap - 0
  if [ -n "$hook_timing" ]; then
    python3 tools/hooks/hook-duration.py --finish "$hook_timing" "$hook_rc" '' </dev/null >/dev/null 2>&1 || true
  fi
  exit "$hook_rc"
}
trap hook_settled 0

# Best-effort git.push fact; never blocks a push.
command -v wrkp >/dev/null 2>&1 && wrkp git push "$@" || true
exit 0
