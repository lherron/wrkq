#!/bin/sh
# just shim — installed AHEAD of the real `just` on PATH by wrkq's `just install`.
#
# Hands every invocation to `wrkp just`, which posts one run.settled fact to the
# project timeline when the justfile opts in with the line
#
#     # wrkp: run.settled
#
# and otherwise execs the real just untouched. The shim must never break just:
# without wrkp it execs the real binary directly.
#
# wrkp is named by its install path, never looked up on PATH (T-12652, D2): a
# prae seat's PATH filter hides wrkp, and run.settled must not depend on it.

# The real just is never this shim, compared FILE to file after following
# symlinks, not directory to directory: ~/.local/shims/just -> ~/.local/bin/just
# sits in a different directory and is still this file. Picking it made
# shim -> wrkp just -> shim exec forever under one pid (T-12652, 2026-11-05).
resolve_file() { # POSIX realpath of a file: follow every symlink, then pwd -P the dir
  f=$1 hops=0
  while [ -L "$f" ]; do
    hops=$((hops + 1)); [ "$hops" -le 40 ] || return 1
    target=$(readlink "$f") || return 1
    case $target in
      /*) f=$target ;;
      *) f=$(dirname "$f")/$target ;;
    esac
  done
  dir=$(cd "$(dirname "$f")" 2>/dev/null && pwd -P) || return 1
  printf '%s/%s\n' "$dir" "$(basename "$f")"
}
is_self() { [ "$(resolve_file "$1" 2>/dev/null)" = "$self" ]; }

self=$(resolve_file "$0")
if [ -n "${WRKP_JUST_BIN:-}" ] && { [ ! -x "$WRKP_JUST_BIN" ] || is_self "$WRKP_JUST_BIN"; }; then
  WRKP_JUST_BIN=
fi
if [ -z "${WRKP_JUST_BIN:-}" ]; then
  saved_ifs=$IFS
  IFS=:
  for dir in $PATH; do
    [ -n "$dir" ] && [ -f "$dir/just" ] && [ -x "$dir/just" ] || continue
    is_self "$dir/just" && continue
    WRKP_JUST_BIN="$dir/just"
    break
  done
  IFS=$saved_ifs
fi
if [ -z "$WRKP_JUST_BIN" ]; then
  echo "just (wrkp shim): no real just binary on PATH besides this shim ($self)" >&2
  exit 127
fi
export WRKP_JUST_BIN

wrkp="$HOME/.local/bin/wrkp"
if [ -x "$wrkp" ]; then
  exec "$wrkp" just -- "$@"
fi
exec "$WRKP_JUST_BIN" "$@"
