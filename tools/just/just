#!/bin/sh
# just shim — installed AHEAD of the real `just` on PATH by wrkq's `just install`.
#
# Hands every invocation to `wrkp just`, which posts one run.settled fact to the
# project timeline when the justfile opts in with the line
#
#     # wrkp: run.settled
#
# and otherwise execs the real just untouched. The shim must never break just:
# without wrkp it execs the real binary directly.
#
# wrkp is named by its install path, never looked up on PATH (T-12652, D2): a
# prae seat's PATH filter hides wrkp, and run.settled must not depend on it.

self_dir=$(cd "$(dirname "$0")" 2>/dev/null && pwd -P)
if [ -z "${WRKP_JUST_BIN:-}" ] || [ ! -x "$WRKP_JUST_BIN" ]; then
  WRKP_JUST_BIN=
  saved_ifs=$IFS
  IFS=:
  for dir in $PATH; do
    [ -n "$dir" ] && [ -f "$dir/just" ] && [ -x "$dir/just" ] || continue
    real_dir=$(cd "$dir" 2>/dev/null && pwd -P) || continue
    [ "$real_dir" = "$self_dir" ] && continue
    WRKP_JUST_BIN="$dir/just"
    break
  done
  IFS=$saved_ifs
fi
if [ -z "$WRKP_JUST_BIN" ]; then
  echo "just (wrkp shim): no real just binary on PATH besides $self_dir/just" >&2
  exit 127
fi
export WRKP_JUST_BIN

wrkp="$HOME/.local/bin/wrkp"
if [ -x "$wrkp" ]; then
  exec "$wrkp" just -- "$@"
fi
exec "$WRKP_JUST_BIN" "$@"
