# ===== PYTHON (FUTURE WORKERS) =====

# Byte-compiled / optimized
__pycache__/
*.py[cod]
*$py.class

# Virtual environments
venv/
env/
ENV/
.venv/
.pyenv/

# Distribution / packaging
*.egg
*.egg-info/
dist/
build/
eggs/
wheels/

# Testing
.pytest_cache/
.coverage
htmlcov/
.tox/

# Type checking
.mypy_cache/
.dmypy.json
dmypy.json

# Jupyter
.ipynb_checkpoints

# ===== BUILD / DEPLOYMENT =====

# Vercel
.vercel/
.vercel/output/

# Docker
.dockerignore.generated

# Terraform (if used)
.terraform/
*.tfstate
*.tfstate.*

# ===== PROJECT SPECIFIC =====

# Generated images/assets (if stored locally)
public/generated/
attached_assets/
uploads/

# CLI offline queue (local cache)
cli/.cache/
cli/queue.db

# Pre-commit output logs
precommit-output.log
prepush-output.log

# Scripts working files
scripts/*.tmp
scripts/*.log

