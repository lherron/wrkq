# ===== GENERAL =====
bin/
tmp/
.playwright-mcp/

# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db

# Editor and IDE files
.vscode/
.idea/
.claude/
.mcp.json
*.swp
*.swo
*~
.project
.settings/
.classpath

# Environment files
.env
.env.local
.env.*.local
!.env.sample
!.env.example

# Logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Temporary files
*.tmp
*.temp
.cache/

# ===== NODE.JS / JAVASCRIPT / TYPESCRIPT =====

# Dependencies
node_modules/
**/node_modules/

# Build outputs
dist/
build/
out/
.next/
.vercel/
apps/web/dist/
apps/api/dist/
packages/*/dist/

# TypeScript
*.tsbuildinfo
.tsc/

# Package manager
package-lock.json
yarn.lock
.pnpm-debug.log
.yarn/
.pnp.*

# Testing
coverage/
.nyc_output/
test-results/
playwright-report/
playwright/.cache/
playwright/.auth/
*.spec.js.snap

# Tooling caches
.eslintcache
.stylelintcache
.prettiercache

# ===== GOLANG =====

# Binaries
cli/bin/
cli/wrkq
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, built with `go test -c`
*.test

# Output of the go coverage tool
cli/coverage.out
cli/coverage.html
*.out

# Go workspace file
go.work
go.work.sum

# Air live reload
tmp/

# Go debugging (Delve)
__debug_bin
__debug_bin.*
.dlv/

# Go crash logs
*.crashlog

# Go profiling
*.pprof
*.prof
cpu.prof
mem.prof
block.prof
mutex.prof

# Go fuzzing corpus (Go 1.18+)
**/testdata/fuzz/

# Go coverage profiles (additional formats)
*.coverprofile
c.out

# Go compiled archives
*.a

# ===== DATABASE =====

# SQLite databases (if used for local dev)
*.db
*.sqlite
*.sqlite3

# PostgreSQL
*.dump
*.sql.backup

# Database baseline (generated, not committed)
db/baseline.sql

# Migration working files
db/migrations/*.tmp

