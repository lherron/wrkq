{
  "schemaVersion": "wrkf.workflow-template.v0",
  "id": "wrkq-simple-task",
  "version": "3",
  "kind": "agent_first_workflow",
  "description": "Built-in executable-action task lifecycle with batch PR verification and release-manager landing.",
  "initial": {
    "status": "active",
    "phase": "intake"
  },
  "roles": {
    "triager": {
      "description": "Shapes the task into a ready implementation target."
    },
    "implementer": {
      "description": "Implements the task and records commit-bound proof."
    },
    "tester": {
      "description": "Verifies the exact implementation commit or artifact."
    },
    "release_manager": {
      "description": "Lands a pr_verified branch after rebase and FrozenBar rerun evidence."
    },
    "system": {
      "description": "Internal workflow projection authority."
    }
  },
  "states": [
    {
      "status": "active",
      "phase": "intake",
      "description": "Task is awaiting triage."
    },
    {
      "status": "active",
      "phase": "ready",
      "description": "Task is ready for implementation."
    },
    {
      "status": "active",
      "phase": "implemented",
      "description": "Implementation evidence is recorded; exact-source verification may begin."
    },
    {
      "status": "waiting",
      "phase": "operator_required",
      "description": "Automatic execution is unsafe or blocked and needs operator attention."
    },
    {
      "status": "waiting",
      "phase": "awaiting_merge",
      "description": "Batch verification produced a PR-bound proof and is awaiting release-manager landing."
    },
    {
      "status": "closed",
      "phase": "done",
      "description": "Terminal success."
    },
    {
      "status": "closed",
      "phase": "cancelled",
      "description": "Terminal cancellation."
    }
  ],
  "evidenceKinds": {
    "triage_result": {
      "class": "note",
      "description": "Triage result.",
      "facts": {
        "properties": {
          "result": {
            "type": "string",
            "enum": ["ready", "operator_required"]
          }
        }
      }
    },
    "implement_result": {
      "class": "note",
      "description": "Commit-bound implementation result.",
      "facts": {
        "required": ["result"],
        "properties": {
          "result": {
            "type": "string",
            "enum": ["done", "blocked", "operator_required"]
          },
          "commit.sha": { "type": "string" },
          "change.id": { "type": "string" },
          "artifact.digest": { "type": "string" },
          "git.clean": { "type": "boolean" },
          "base.sha": { "type": "string" },
          "postcondition": {
            "type": "string",
            "enum": ["git_committed_clean"]
          },
          "repair.turns": { "type": "integer" }
        }
      }
    },
    "verify_result": {
      "class": "verify",
      "description": "Verification result bound to a specific implementation source.",
      "facts": {
        "required": ["result"],
        "properties": {
          "result": {
            "type": "string",
            "enum": ["verified", "pr_verified", "failed", "blocked", "operator_required"]
          },
          "source.evidence_id": { "type": "string" },
          "source.commit.sha": { "type": "string" },
          "verified.commit.sha": { "type": "string" },
          "verified.change.id": { "type": "string" },
          "branch.head.sha": { "type": "string" },
          "bar.hash": { "type": "string" },
          "pr.url": { "type": "string" },
          "artifact.digest": { "type": "string" },
          "install.exit": { "type": "integer" },
          "smoke.exit": { "type": "integer" },
          "git.clean": { "type": "boolean" }
        }
      }
    },
    "landing_result": {
      "class": "verify",
      "description": "Release-manager landing result linking pr_verified evidence, rebase/range evidence, merged main SHA, and FrozenBar rerun proof.",
      "facts": {
        "required": [
          "result",
          "source.evidence_id",
          "source.change.id",
          "source.branch.head.sha",
          "source.bar.hash",
          "source.pr.url",
          "rebased.head.sha",
          "merged.main.sha",
          "pr.url",
          "rebase.range",
          "frozen_bar.result",
          "frozen_bar.command_hash",
          "frozen_bar.expected_command_hash",
          "frozen_bar.content_hash",
          "frozen_bar.expected_content_hash",
          "bar.changed"
        ],
        "properties": {
          "result": {
            "type": "string",
            "enum": ["landed", "reverify_required", "operator_required"]
          },
          "source.evidence_id": { "type": "string" },
          "source.change.id": { "type": "string" },
          "source.verify.evidence_id": { "type": "string" },
          "source.branch.head.sha": { "type": "string" },
          "source.bar.hash": { "type": "string" },
          "source.pr.url": { "type": "string" },
          "rebased.head.sha": { "type": "string" },
          "merged.main.sha": { "type": "string" },
          "pr.url": { "type": "string" },
          "rebase.range": { "type": "string" },
          "frozen_bar.result": {
            "type": "string",
            "enum": ["passed", "failed"]
          },
          "frozen_bar.command_hash": { "type": "string" },
          "frozen_bar.expected_command_hash": { "type": "string" },
          "frozen_bar.content_hash": { "type": "string" },
          "frozen_bar.expected_content_hash": { "type": "string" },
          "bar.changed": { "type": "boolean" }
        }
      }
    },
    "failure_result": {
      "class": "note",
      "description": "Operational or ownership failure result."
    },
    "operator_resolution": {
      "class": "note",
      "description": "Supervisor/operator decision resolving a waiting/operator_required workflow.",
      "producibleBy": ["supervisor"],
      "facts": {
        "required": ["resolution"],
        "properties": {
          "resolution": {
            "type": "string",
            "enum": ["resume_ready", "cancelled", "close"]
          },
          "reason": { "type": "string" }
        }
      }
    }
  },
  "transitions": [
    {
      "id": "triage_complete",
      "description": "Triage accepted the task for implementation.",
      "from": {
        "status": "active",
        "phase": "intake"
      },
      "by": ["triager"],
      "outcomes": [
        {
          "id": "ready",
          "when": {
            "evidenceExists": {
              "kind": "triage_result",
              "facts": {
                "result": "ready"
              }
            }
          },
          "to": {
            "status": "active",
            "phase": "ready"
          },
          "effects": [
            {
              "kind": "set_task_state",
              "role": "system",
              "semanticKey": "task-state:{taskUuid}:{revision}:open",
              "data": {
                "state": "open"
              }
            }
          ]
        },
        {
          "id": "operator_required",
          "when": {
            "otherwise": true
          },
          "to": {
            "status": "waiting",
            "phase": "operator_required"
          }
        }
      ]
    },
    {
      "id": "implement_complete",
      "description": "Implementation produced commit-bound evidence or a safe terminal blocker.",
      "from": {
        "status": "active",
        "phase": "ready"
      },
      "by": ["implementer"],
      "outcomes": [
        {
          "id": "done",
          "when": {
            "evidenceExists": {
              "kind": "implement_result",
              "facts": {
                "result": "done"
              }
            }
          },
          "to": {
            "status": "active",
            "phase": "implemented"
          }
        },
        {
          "id": "blocked",
          "when": {
            "evidenceExists": {
              "kind": "implement_result",
              "facts": {
                "result": "blocked"
              }
            }
          },
          "to": {
            "status": "active",
            "phase": "ready"
          },
          "effects": [
            {
              "kind": "set_task_state",
              "role": "system",
              "semanticKey": "task-state:{taskUuid}:{revision}:blocked",
              "data": {
                "state": "blocked"
              }
            }
          ]
        },
        {
          "id": "operator_required",
          "when": {
            "otherwise": true
          },
          "to": {
            "status": "waiting",
            "phase": "operator_required"
          }
        }
      ]
    },
    {
      "id": "verify_complete",
      "description": "Verification checked the exact source commit or artifact from implementation.",
      "from": {
        "status": "active",
        "phase": "implemented"
      },
      "by": ["tester"],
      "outcomes": [
        {
          "id": "verified",
          "when": {
            "evidenceExists": {
              "kind": "verify_result",
              "facts": {
                "result": "verified"
              }
            }
          },
          "to": {
            "status": "closed",
            "phase": "done"
          },
          "effects": [
            {
              "kind": "set_task_state",
              "role": "system",
              "semanticKey": "task-state:{taskUuid}:{revision}:completed",
              "data": {
                "state": "completed"
              }
            }
          ]
        },
        {
          "id": "pr_verified",
          "when": {
            "evidenceExists": {
              "kind": "verify_result",
              "facts": {
                "result": "pr_verified"
              }
            }
          },
          "to": {
            "status": "waiting",
            "phase": "awaiting_merge"
          }
        },
        {
          "id": "failed",
          "when": {
            "evidenceExists": {
              "kind": "verify_result",
              "facts": {
                "result": "failed"
              }
            }
          },
          "to": {
            "status": "active",
            "phase": "ready"
          },
          "effects": [
            {
              "kind": "set_task_state",
              "role": "system",
              "semanticKey": "task-state:{taskUuid}:{revision}:blocked",
              "data": {
                "state": "blocked"
              }
            }
          ]
        },
        {
          "id": "blocked",
          "when": {
            "evidenceExists": {
              "kind": "verify_result",
              "facts": {
                "result": "blocked"
              }
            }
          },
          "to": {
            "status": "active",
            "phase": "ready"
          },
          "effects": [
            {
              "kind": "set_task_state",
              "role": "system",
              "semanticKey": "task-state:{taskUuid}:{revision}:blocked",
              "data": {
                "state": "blocked"
              }
            }
          ]
        },
        {
          "id": "operator_required",
          "when": {
            "otherwise": true
          },
          "to": {
            "status": "waiting",
            "phase": "operator_required"
          }
        }
      ]
    },
    {
      "id": "landing_complete",
      "description": "Release manager landed a pr_verified branch after rebase and FrozenBar rerun evidence.",
      "from": {
        "status": "waiting",
        "phase": "awaiting_merge"
      },
      "by": ["release_manager"],
      "outcomes": [
        {
          "id": "landed",
          "when": {
            "evidenceExists": {
              "kind": "landing_result",
              "facts": {
                "result": "landed"
              }
            }
          },
          "to": {
            "status": "closed",
            "phase": "done"
          },
          "effects": [
            {
              "kind": "set_task_state",
              "role": "system",
              "semanticKey": "task-state:{taskUuid}:{revision}:completed",
              "data": {
                "state": "completed"
              }
            }
          ]
        },
        {
          "id": "operator_required",
          "when": {
            "otherwise": true
          },
          "to": {
            "status": "waiting",
            "phase": "operator_required"
          }
        }
      ]
    },
    {
      "id": "operator_resolved",
      "description": "Supervisor recorded operator resolution evidence for a workflow waiting on human/operator intervention.",
      "from": {
        "status": "waiting",
        "phase": "operator_required"
      },
      "by": ["supervisor"],
      "requires": [
        {
          "evidence": {
            "kind": "operator_resolution"
          }
        }
      ],
      "outcomes": [
        {
          "id": "resume_ready",
          "when": {
            "evidenceExists": {
              "kind": "operator_resolution",
              "facts": {
                "resolution": "resume_ready"
              }
            }
          },
          "to": {
            "status": "active",
            "phase": "ready"
          },
          "effects": [
            {
              "kind": "set_task_state",
              "role": "system",
              "semanticKey": "task-state:{taskUuid}:{revision}:open",
              "data": {
                "state": "open"
              }
            }
          ]
        },
        {
          "id": "cancelled",
          "when": {
            "evidenceExists": {
              "kind": "operator_resolution",
              "facts": {
                "resolution": "cancelled"
              }
            }
          },
          "to": {
            "status": "closed",
            "phase": "cancelled"
          },
          "effects": [
            {
              "kind": "set_task_state",
              "role": "system",
              "semanticKey": "task-state:{taskUuid}:{revision}:cancelled",
              "data": {
                "state": "cancelled"
              }
            }
          ]
        },
        {
          "id": "closed",
          "when": {
            "evidenceExists": {
              "kind": "operator_resolution",
              "facts": {
                "resolution": "close"
              }
            }
          },
          "to": {
            "status": "closed",
            "phase": "done"
          },
          "effects": [
            {
              "kind": "set_task_state",
              "role": "system",
              "semanticKey": "task-state:{taskUuid}:{revision}:completed",
              "data": {
                "state": "completed"
              }
            }
          ]
        }
      ]
    }
  ],
  "executableActions": {
    "triage": {
      "from": {
        "status": "active",
        "phase": "intake"
      },
      "role": "triager",
      "transition": "triage_complete",
      "resultEvidenceKind": "triage_result",
      "handlerContract": "praesidium.wrkq-simple-task.triage@1",
      "workspaceMode": "read-only",
      "rank": 10
    },
    "implement": {
      "from": {
        "status": "active",
        "phase": "ready"
      },
      "role": "implementer",
      "transition": "implement_complete",
      "resultEvidenceKind": "implement_result",
      "handlerContract": "praesidium.wrkq-simple-task.implement@1",
      "workspaceMode": "exclusive",
      "sideEffectClasses": ["worktree.write", "git.commit"],
      "settleValidation": {
        "rules": [
          {
            "whenFacts": { "result": "done" },
            "requiredFacts": ["commit.sha", "change.id", "git.clean", "base.sha", "postcondition", "repair.turns"],
            "valueConstraints": [
              { "fact": "postcondition", "equals": "git_committed_clean" },
              { "fact": "git.clean", "equals": "true" }
            ]
          }
        ]
      },
      "continuation": {
        "next": "verify",
        "attentionScope": "workspace",
        "requireExactSource": true
      },
      "rank": 20
    },
    "verify": {
      "from": {
        "status": "active",
        "phase": "implemented"
      },
      "role": "tester",
      "transition": "verify_complete",
      "resultEvidenceKind": "verify_result",
      "handlerContract": "praesidium.wrkq-simple-task.verify@1",
      "workspaceMode": "exclusive",
      "sideEffectClasses": ["install", "smoke", "test", "git.push", "github.pr.create"],
      "sourceBinding": {
        "kind": "previous_action",
        "action": "implement",
        "requiredFacts": ["commit.sha", "change.id"],
        "bindFields": {
          "sourceIdentity": "change.id"
        }
      },
      "settleValidation": {
        "rules": [
          {
            "identityFact": "verified.change.id",
            "linkageFact": "source.evidence_id",
            "requiredFacts": ["source.evidence_id", "source.commit.sha", "verified.commit.sha", "verified.change.id", "git.clean"],
            "echoFields": [
              { "fact": "source.commit.sha", "sourceFact": "commit.sha" },
              { "fact": "verified.commit.sha", "sourceFact": "commit.sha" }
            ],
            "valueConstraints": [
              { "fact": "git.clean", "equals": "true" }
            ]
          }
        ]
      },
      "rank": 30
    },
    "landing": {
      "from": {
        "status": "waiting",
        "phase": "awaiting_merge"
      },
      "role": "release_manager",
      "transition": "landing_complete",
      "resultEvidenceKind": "landing_result",
      "handlerContract": "praesidium.wrkq-simple-task.landing@1",
      "workspaceMode": "exclusive",
      "sideEffectClasses": ["git.rebase", "test", "git.merge"],
      "sourceBinding": {
        "kind": "previous_action",
        "action": "verify",
        "requiredFacts": ["result", "verified.change.id", "branch.head.sha", "bar.hash", "pr.url"],
        "bindFields": {
          "sourceIdentity": "verified.change.id",
          "artifactRef": "bar.hash"
        }
      },
      "settleValidation": {
        "rules": [
          {
            "identityFact": "source.change.id",
            "linkageFact": "source.evidence_id",
            "requiredFacts": ["source.evidence_id", "source.change.id", "source.branch.head.sha", "source.bar.hash", "source.pr.url", "rebased.head.sha", "merged.main.sha", "pr.url", "rebase.range", "frozen_bar.result", "frozen_bar.command_hash", "frozen_bar.expected_command_hash", "frozen_bar.content_hash", "frozen_bar.expected_content_hash", "bar.changed"],
            "echoFields": [
              { "fact": "source.change.id", "sourceFact": "verified.change.id" },
              { "fact": "source.branch.head.sha", "sourceFact": "branch.head.sha" },
              { "fact": "source.bar.hash", "sourceFact": "bar.hash" },
              { "fact": "source.pr.url", "sourceFact": "pr.url" },
              { "fact": "pr.url", "sourceFact": "pr.url" }
            ],
            "valueConstraints": [
              { "fact": "frozen_bar.result", "equals": "passed" },
              { "fact": "frozen_bar.command_hash", "equalsFact": "frozen_bar.expected_command_hash" },
              { "fact": "frozen_bar.content_hash", "equalsFact": "frozen_bar.expected_content_hash" },
              { "fact": "bar.changed", "equals": "false" }
            ]
          }
        ]
      },
      "rank": 40
    }
  }
}
